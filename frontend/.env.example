# ─────────────────────────────────────────────────────────────
#  Sandbox Playground — Frontend environment variables
#  Copy to `.env.local` and fill in for a real deployment.
#  With the defaults below the SPA runs fully in DEMO/MOCK mode
#  (no backend, no Google OAuth client required).
# ─────────────────────────────────────────────────────────────

# Backend base URL (FastAPI). Only used when VITE_USE_MOCKS=false.
# Deployed backend: https://sandbox-dev-backend-cescdxppma-ew.a.run.app/api
VITE_API_BASE_URL=http://localhost:8000/api

# Use the in-browser mock API instead of a live backend.
# true  -> realistic fake data, scans progress on a simulated clock
# false -> calls the real FastAPI backend at VITE_API_BASE_URL
VITE_USE_MOCKS=true

# Auth provider: "mock" (instant demo login) or "google" (real Google OAuth).
VITE_AUTH_MODE=mock

# Google OAuth — required when VITE_AUTH_MODE=google.
# Web application OAuth 2.0 client ID from the Google Cloud console.
#
# The client must list, under "Authorized JavaScript origins":
#   http://localhost:5173                                    (local dev)
#   https://sandbox-dev-frontend-cescdxppma-ew.a.run.app     (Cloud Run)
#
# The SPA sends the resulting ID token as the bearer; the backend verifies its
# signature and that aud equals this same client ID.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Real Google sign-in against mock data ────────────────────
# Useful before the FastAPI backend exists — real login, fake scans:
#   VITE_AUTH_MODE=google
#   VITE_GOOGLE_CLIENT_ID=<your client id>
#   VITE_USE_MOCKS=true

# ─────────────────────────────────────────────────────────────
#  Sandbox Playground — Backend environment variables
#  Copy to `backend/.env` and fill in. Read by pydantic-settings
#  (app/core/config.py) relative to the working directory, so run
#  uvicorn from `backend/`.
# ─────────────────────────────────────────────────────────────

# ── GCP ──────────────────────────────────────────────────────
# Required. The app fails to import without it — SharedSettings is
# constructed at module load so both containers fail fast, not mid-request.
GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west1
ENVIRONMENT=dev

# ── Credentials for GCP ──────────────────────────────────────
# How the app authenticates to Cloud SQL, Firestore, Vertex AI and Cloud Run.
# Leave unset to use ambient credentials — the runtime service account on
# Cloud Run, or `gcloud auth application-default login` locally.
#
# Set it to a service-account key file to run on a machine with no gcloud and
# no Google account. The key needs roles/cloudsql.client (database),
# roles/datastore.user (Firestore), roles/run.developer (launch scans) and
# roles/aiplatform.user (AI enrichment) — see infrastructure/gcp/iam.tf.
# Relative paths resolve against the working directory. Never commit the file;
# `*-key.json` is already gitignored.
# GOOGLE_APPLICATION_CREDENTIALS=sa-key.json

# ── Database (Cloud SQL for PostgreSQL) ──────────────────────
# All required. Connections go through the Cloud SQL Python Connector, which
# needs outbound TCP 3307. DB_HOST is required by config but never dialled —
# the instance has no authorized networks, so a direct connection is refused
# and the connector is the only way in.
DB_INSTANCE_CONNECTION_NAME=your-project:europe-west1:your-instance
DB_HOST=127.0.0.1
DB_NAME=sandbox
DB_USER=sandbox_app
DB_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────
# Required. The audience the backend checks on every incoming Google ID token;
# must be the same client ID the SPA builds with (VITE_GOOGLE_CLIENT_ID).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated CORS origins. Empty means every browser call is blocked, so
# a local frontend needs its dev-server origin listed here.
ALLOWED_ORIGINS=http://localhost:5173

# ── Temporary guest sign-in ──────────────────────────────────
# Accepts the `guest.user` / `guest.admin` bearer and shows the guest buttons'
# backing path. Off by default: while it is on, anyone who can reach the API
# can take an admin session, by design — there is no passcode. Turn it off
# after the review. See app/core/deps.py.
GUEST_MODE_ENABLED=false

# ── Optional ─────────────────────────────────────────────────
# PEM-encoded RSA private key used to sign exported reports. Unset means
# exports are served with no signature headers rather than a throwaway one.
# REPORT_SIGNING_KEY=

# Serves /docs, /redoc and /openapi.json. Off in deployments — the schema
# lists every route, admin paths included.
ENABLE_API_DOCS=false

# Custom project-level IAM role whose members are the app's admins.
ADMIN_IAM_ROLE_ID=appAdmin

ARTIFACT_REGISTRY_REPO=sandbox-images
SCANNER_JOB_NAME=sandbox-dev-scanner

# Firestore and Vertex AI. Defaults match the deployed setup; override only if
# your project uses a different database or model.
FIRESTORE_DATABASE=(default)
VERTEX_LOCATION=europe-west1
VERTEX_MODEL=gemini-2.5-flash
